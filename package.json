{
  "name": "session-desk",
  "displayName": "Session Desk for Claude Code",
  "description": "A desk for your Claude Code sessions: real names, live status, unread replies, groups with color and emoji, pins and archive, in a sidebar.",
  "version": "1.0.0",
  "publisher": "lamimwork",
  "license": "MIT",
  "icon": "media/icon.png",
  "author": { "name": "Daniel Lamim" },
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other"],
  "keywords": ["claude", "claude code", "anthropic", "sessions", "pin", "productivity"],
  "repository": { "type": "git", "url": "https://github.com/Lamimwork/session-desk.git" },
  "bugs": { "url": "https://github.com/Lamimwork/session-desk/issues" },
  "homepage": "https://github.com/Lamimwork/session-desk#readme",
  "main": "./dist/extension.js",
  "contributes": {
    "colors": [
      { "id": "sessionDesk.pink", "description": "Group color: pink", "defaults": { "dark": "#F48FB1", "light": "#C2185B", "highContrast": "#F48FB1", "highContrastLight": "#C2185B" } },
      { "id": "sessionDesk.magenta", "description": "Group color: magenta", "defaults": { "dark": "#E040FB", "light": "#AA00C8", "highContrast": "#E040FB", "highContrastLight": "#AA00C8" } },
      { "id": "sessionDesk.teal", "description": "Group color: teal", "defaults": { "dark": "#4DB6AC", "light": "#00796B", "highContrast": "#4DB6AC", "highContrastLight": "#00796B" } },
      { "id": "sessionDesk.cyan", "description": "Group color: cyan", "defaults": { "dark": "#4DD0E1", "light": "#0097A7", "highContrast": "#4DD0E1", "highContrastLight": "#0097A7" } },
      { "id": "sessionDesk.lime", "description": "Group color: lime", "defaults": { "dark": "#C6E35A", "light": "#689F38", "highContrast": "#C6E35A", "highContrastLight": "#689F38" } },
      { "id": "sessionDesk.gold", "description": "Group color: gold", "defaults": { "dark": "#FFC940", "light": "#B8860B", "highContrast": "#FFC940", "highContrastLight": "#B8860B" } },
      { "id": "sessionDesk.brown", "description": "Group color: brown", "defaults": { "dark": "#C49A6C", "light": "#795548", "highContrast": "#C49A6C", "highContrastLight": "#795548" } },
      { "id": "sessionDesk.indigo", "description": "Group color: indigo", "defaults": { "dark": "#9FA8DA", "light": "#3949AB", "highContrast": "#9FA8DA", "highContrastLight": "#3949AB" } },
      { "id": "sessionDesk.gray", "description": "Group color: gray", "defaults": { "dark": "#A0A0A0", "light": "#616161", "highContrast": "#A0A0A0", "highContrastLight": "#616161" } }
    ],
    "configuration": {
      "title": "Session Desk",
      "properties": {
        "sessionDesk.showGroupCounts": {
          "type": "boolean",
          "default": true,
          "description": "Show session counts next to group names (\"(5)\", \"2 open · 7 closed\"). Unread counts are always shown."
        },
        "sessionDesk.showClosed": {
          "type": "boolean",
          "default": true,
          "description": "Show the \"Closed\" sub-section inside each group. When off, closed sessions stay reachable through Search and History."
        },
        "sessionDesk.fadeIdleAfterMinutes": {
          "type": "number",
          "default": 10,
          "minimum": 0,
          "description": "Fade the name of a session idle for this many minutes, so the ones in use stand out. Closed sessions are always faded; sessions with an unread reply never are. 0 turns off fading of idle sessions."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sessionDesk",
          "title": "Session Desk",
          "icon": "media/pin.svg"
        }
      ]
    },
    "views": {
      "sessionDesk": [
        { "id": "sessionDesk.sessions", "name": "📌 Sessions" }
      ]
    },
    "commands": [
      { "command": "sessionDesk.sessions.new", "title": "New Session", "category": "Session Desk", "icon": "$(add)" },
      { "command": "sessionDesk.sessions.refresh", "title": "Refresh Sessions", "category": "Session Desk", "icon": "$(refresh)" },
      { "command": "sessionDesk.sessions.open", "title": "Open Session", "category": "Session Desk" },
      { "command": "sessionDesk.sessions.pin", "title": "Pin Session", "category": "Session Desk", "icon": "$(pin)" },
      { "command": "sessionDesk.sessions.unpin", "title": "Unpin Session", "category": "Session Desk", "icon": "$(pinned)" },
      { "command": "sessionDesk.sessions.rename", "title": "Rename Session", "category": "Session Desk", "icon": "$(edit)" },
      { "command": "sessionDesk.sessions.copyId", "title": "Copy Session ID", "category": "Session Desk" },
      { "command": "sessionDesk.sessions.copyPath", "title": "Copy Transcript Path", "category": "Session Desk" },
      { "command": "sessionDesk.sessions.delete", "title": "Delete Session", "category": "Session Desk", "icon": "$(trash)" },
      { "command": "sessionDesk.sessions.search", "title": "Search Sessions", "category": "Session Desk", "icon": "$(search)" },
      { "command": "sessionDesk.sessions.setColor", "title": "Set Color", "category": "Session Desk", "icon": "$(symbol-color)" },
      { "command": "sessionDesk.sessions.setEmoji", "title": "Set Emoji", "category": "Session Desk", "icon": "$(smiley)" },
      { "command": "sessionDesk.sessions.setGroup", "title": "Set Group", "category": "Session Desk", "icon": "$(folder)" },
      { "command": "sessionDesk.sessions.archive", "title": "Archive Session", "category": "Session Desk", "icon": "$(archive)" },
      { "command": "sessionDesk.sessions.unarchive", "title": "Unarchive Session", "category": "Session Desk", "icon": "$(inbox)" },
      { "command": "sessionDesk.sessions.archiveOld", "title": "Archive Old Sessions…", "category": "Session Desk", "icon": "$(archive)" },
      { "command": "sessionDesk.sessions.markRead", "title": "Mark as Read", "category": "Session Desk", "icon": "$(check)" },
      { "command": "sessionDesk.view.hideCounts", "title": "Hide Group Counts", "category": "Session Desk" },
      { "command": "sessionDesk.view.showCounts", "title": "Show Group Counts", "category": "Session Desk" },
      { "command": "sessionDesk.view.hideClosed", "title": "Hide Closed Sessions", "category": "Session Desk" },
      { "command": "sessionDesk.view.showClosed", "title": "Show Closed Sessions", "category": "Session Desk" },
      { "command": "sessionDesk.sessions.markAllRead", "title": "Mark All as Read", "category": "Session Desk", "icon": "$(check-all)" },
      { "command": "sessionDesk.groups.setEmoji", "title": "Set Group Emoji", "category": "Session Desk", "icon": "$(smiley)" },
      { "command": "sessionDesk.groups.setColor", "title": "Set Group Color", "category": "Session Desk", "icon": "$(symbol-color)" }
    ],
    "menus": {
      "commandPalette": [
        { "command": "sessionDesk.sessions.open", "when": "false" },
        { "command": "sessionDesk.sessions.pin", "when": "false" },
        { "command": "sessionDesk.sessions.unpin", "when": "false" },
        { "command": "sessionDesk.sessions.rename", "when": "false" },
        { "command": "sessionDesk.sessions.markRead", "when": "view == sessionDesk.sessions && viewItem =~ /Session$/", "group": "1_read" },
        { "command": "sessionDesk.groups.setEmoji", "when": "view == sessionDesk.sessions && viewItem == customGroup", "group": "2_customize@1" },
        { "command": "sessionDesk.groups.setColor", "when": "view == sessionDesk.sessions && viewItem == customGroup", "group": "2_customize@2" },
        { "command": "sessionDesk.sessions.copyId", "when": "false" },
        { "command": "sessionDesk.sessions.copyPath", "when": "false" },
        { "command": "sessionDesk.sessions.delete", "when": "false" },
        { "command": "sessionDesk.sessions.setColor", "when": "false" },
        { "command": "sessionDesk.sessions.setEmoji", "when": "false" },
        { "command": "sessionDesk.sessions.setGroup", "when": "false" },
        { "command": "sessionDesk.sessions.archive", "when": "false" },
        { "command": "sessionDesk.sessions.unarchive", "when": "false" },
        { "command": "sessionDesk.sessions.markRead", "when": "false" },
        { "command": "sessionDesk.groups.setEmoji", "when": "false" },
        { "command": "sessionDesk.groups.setColor", "when": "false" }
      ],
      "view/title": [
        { "command": "sessionDesk.sessions.new", "when": "view == sessionDesk.sessions", "group": "navigation@0" },
        { "command": "sessionDesk.sessions.search", "when": "view == sessionDesk.sessions", "group": "navigation@1" },
        { "command": "sessionDesk.sessions.archiveOld", "when": "view == sessionDesk.sessions", "group": "navigation@2" },
        { "command": "sessionDesk.sessions.refresh", "when": "view == sessionDesk.sessions", "group": "navigation@3" },
        { "command": "sessionDesk.sessions.markAllRead", "when": "view == sessionDesk.sessions", "group": "1_unread" },
        { "command": "sessionDesk.view.hideCounts", "when": "view == sessionDesk.sessions && config.sessionDesk.showGroupCounts", "group": "2_view" },
        { "command": "sessionDesk.view.showCounts", "when": "view == sessionDesk.sessions && !config.sessionDesk.showGroupCounts", "group": "2_view" },
        { "command": "sessionDesk.view.hideClosed", "when": "view == sessionDesk.sessions && config.sessionDesk.showClosed", "group": "2_view" },
        { "command": "sessionDesk.view.showClosed", "when": "view == sessionDesk.sessions && !config.sessionDesk.showClosed", "group": "2_view" }
      ],
      "view/item/context": [
        { "command": "sessionDesk.sessions.rename", "when": "view == sessionDesk.sessions && viewItem =~ /Session$/", "group": "inline@1" },
        { "command": "sessionDesk.sessions.pin", "when": "view == sessionDesk.sessions && viewItem == unpinnedSession", "group": "inline@2" },
        { "command": "sessionDesk.sessions.unpin", "when": "view == sessionDesk.sessions && viewItem == pinnedSession", "group": "inline@2" },
        { "command": "sessionDesk.sessions.delete", "when": "view == sessionDesk.sessions && viewItem =~ /Session$/", "group": "inline@3" },
        { "command": "sessionDesk.sessions.setColor", "when": "view == sessionDesk.sessions && viewItem =~ /Session$/", "group": "2_customize@1" },
        { "command": "sessionDesk.sessions.setEmoji", "when": "view == sessionDesk.sessions && viewItem =~ /Session$/", "group": "2_customize@2" },
        { "command": "sessionDesk.sessions.setGroup", "when": "view == sessionDesk.sessions && viewItem =~ /Session$/", "group": "2_customize@3" },
        { "command": "sessionDesk.sessions.archive", "when": "view == sessionDesk.sessions && (viewItem == unpinnedSession || viewItem == pinnedSession)", "group": "3_archive" },
        { "command": "sessionDesk.sessions.unarchive", "when": "view == sessionDesk.sessions && viewItem == archivedSession", "group": "3_archive" },
        { "command": "sessionDesk.sessions.markRead", "when": "view == sessionDesk.sessions && viewItem =~ /Session$/", "group": "1_read" },
        { "command": "sessionDesk.groups.setEmoji", "when": "view == sessionDesk.sessions && viewItem == customGroup", "group": "2_customize@1" },
        { "command": "sessionDesk.groups.setColor", "when": "view == sessionDesk.sessions && viewItem == customGroup", "group": "2_customize@2" },
        { "command": "sessionDesk.sessions.copyId", "when": "view == sessionDesk.sessions && viewItem =~ /Session$/", "group": "5_copy" },
        { "command": "sessionDesk.sessions.copyPath", "when": "view == sessionDesk.sessions && viewItem =~ /Session$/", "group": "5_copy" }
      ]
    }
  },
  "scripts": {
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "test": "vitest run",
    "vscode:prepublish": "node esbuild.js --production"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.21.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
